{
  "$comment": "Extracted verbatim from tailwind.config.js and src/index.css. Values are the measured originals from the orchestra.bio rebuild — do not round or 'tidy' them; the odd decimals (521.47px, 242.52px, 94.94px) are real measurements, not typos.",
  "meta": {
    "source": "tailwind.config.js + src/index.css",
    "extractedFrom": "code",
    "status": "verified-against-source"
  },
  "color": {
    "ink":        { "value": "#032126", "role": "Primary dark surface. Hero, navbar, footer, updates band." },
    "ink-2":      { "value": "#24474D", "role": "Raised surface on ink (image placeholder wells)." },
    "ink-3":      { "value": "#375257", "role": "Hairline/·border on ink." },
    "paper":      { "value": "#E8ECE9", "role": "Default page background (body)." },
    "paper-2":    { "value": "#D9E1DC", "role": "Recessed paper surface (video well)." },
    "paper-3":    { "value": "#D0DDD5", "role": "Muted display type on ink (hero second line)." },
    "cream":      { "value": "#F6F4F3", "role": "Light-on-dark display type; light pill fill." },
    "sage":       { "value": "#5B9383", "role": "Secondary accent." },
    "sage-deep":  { "value": "#365E55", "role": "Secondary accent, pressed/deep." },
    "mint":       { "value": "#A7D5B8", "role": "Primary action fill; selection background." },
    "mint-soft":  { "value": "#9DBDAB", "role": "Eyebrow + section heading on ink." },
    "mint-pale":  { "value": "#B8CDC1", "role": "Subhead body copy on ink." },
    "muted":      { "value": "#768787", "role": "Tertiary body copy on paper." },
    "blue":       { "value": "#9CB6E0", "role": "Timeline lane accent." },
    "blue-deep":  { "value": "#264881", "role": "Timeline lane accent, deep." },
    "blue-pale":  { "value": "#CED9EB", "role": "Timeline lane accent, pale." },
    "rose":       { "value": "#CE9599", "role": "Timeline lane accent." },
    "rose-pale":  { "value": "#D3BBBB", "role": "Timeline lane accent, pale." },
    "clay":       { "value": "#E28468", "role": "Timeline lane accent, warm." },
    "clay-deep":  { "value": "#5E3120", "role": "Timeline lane accent, warm deep." }
  },
  "font": {
    "$comment": "Display and body are open substitutes for the original's licensed Greed Standard (Displaay) and Tiempos Text (Klim). Families with spaces/digits MUST stay quoted — Tailwind emits the array verbatim and unquoted 'Source Serif 4' is invalid CSS the browser silently drops.",
    "display": { "value": ["'General Sans'", "Inter", "system-ui", "sans-serif"], "substituteFor": "Greed Standard (Displaay)" },
    "body":    { "value": ["'Source Serif 4'", "Georgia", "serif"], "substituteFor": "Tiempos Text (Klim)" },
    "sans":    { "value": ["'Source Serif 4'", "Georgia", "serif"], "note": "Aliased to body; the design has no separate sans body face." },
    "mono":    { "value": ["'IBM Plex Mono'", "ui-monospace", "monospace"], "role": "Eyebrows only." }
  },
  "fontWeight": {
    "$comment": "Display face renders at 500 everywhere on the original. Only 500/600 are loaded, so leaving elements at the default 400 let the browser pick 500 while the computed weight still read 400 — a real measured drift. .font-display/.btn/.eyebrow force 500 in the base layer.",
    "display": { "value": 500 }
  },
  "fontSize": {
    "display-xl": { "size": "76px", "lineHeight": "79.8px", "letterSpacing": "-1.52px", "role": "Hero + CTA headline." },
    "display-lg": { "size": "56px", "lineHeight": "60px",   "letterSpacing": "-1.12px", "role": "Product hero title; pillar heading." },
    "display-md": { "size": "48px", "lineHeight": "52px",   "letterSpacing": "-0.96px", "role": "Section headings." },
    "body-lg":    { "size": "20px", "lineHeight": "28px",   "letterSpacing": "-0.4px" },
    "body-md":    { "size": "18px", "lineHeight": "26px",   "letterSpacing": "-0.18px", "role": "Subheads." },
    "body-sm":    { "size": "16px", "lineHeight": "24px",   "letterSpacing": "-0.16px" },
    "body-xs":    { "size": "14px", "lineHeight": "22px",   "letterSpacing": "-0.14px" },
    "label":      { "size": "15px", "lineHeight": "23px" },
    "eyebrow":    { "size": "13px", "lineHeight": "22px",   "letterSpacing": "0.65px", "role": "Mono, uppercase." }
  },
  "layout": {
    "$comment": "The shell is full-bleed with 32px gutters: content runs 32..1248 at a 1280 viewport (1216 wide). max-w-[1216px] + px-8 would inset to 64..1216 (1152 wide) — 64px too narrow and 32px off-axis. This is why .shell uses calc(1216px + 64px).",
    "shell":      { "value": "1216px", "gutter": { "base": "20px", "md": "32px" }, "cssMaxWidth": "calc(1216px + 64px)" },
    "inner":      { "value": "1120px" },
    "measure":    { "value": "700px", "role": "Hero/CTA headline + subhead column." },
    "article":    { "value": "800px", "role": "Blog post body measure." },
    "navbarHeight": { "value": "88px" }
  },
  "motion": {
    "reveal":  { "duration": "0.7s", "easing": "cubic-bezier(0.22, 1, 0.36, 1)", "distance": "24px", "trigger": "IntersectionObserver threshold 0.15, rootMargin 0px 0px -10% 0px, unobserve after fire" },
    "marquee": { "duration": "40s", "easing": "linear", "iteration": "infinite", "technique": "Duplicate-and-loop: track holds two identical halves, translateX(-50%) lands on the seam.", "pauseOnHover": true },
    "buttonPress": { "duration": "150ms", "easing": "ease-out", "transform": "scale(0.98)" },
    "imageHover":  { "duration": "500ms", "easing": "ease-out", "transform": "scale(1.03)" },
    "reducedMotion": "All marquee + reveal motion is disabled under prefers-reduced-motion: reduce."
  },
  "radius": {
    "pill": { "value": "9999px", "role": "All CTAs." },
    "card": { "value": "0.75rem", "role": "Post cover images (rounded-xl)." }
  }
}
